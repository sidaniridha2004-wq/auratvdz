# Copy to .env for local development. Never commit .env.

# --- Public (shipped to the browser; must not contain secrets) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Google Analytics 4 measurement ID. Leave empty to disable analytics.
VITE_GA_MEASUREMENT_ID=

# --- Server only ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Service-role key. Required for admin writes; bypasses RLS, keep it secret.
SUPABASE_SERVICE_ROLE_KEY=

# Admin password for /admin. Long and random. Rotating it signs every session out.
ADMIN_PASSWORD=
# Separate secret used to sign admin session tokens (32+ random chars).
ADMIN_SESSION_SECRET=
# Signs stream proxy URLs so the relay cannot be pointed at arbitrary hosts.
STREAM_SIGNING_SECRET=

# Optional upstream overrides
YACINE_API_URL=https://def.yacinelive.com
YACINE_DECRYPT_KEY=
AURATV_MANIFEST_URL=
